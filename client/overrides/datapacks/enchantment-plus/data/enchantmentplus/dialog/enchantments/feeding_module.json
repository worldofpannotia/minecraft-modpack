{
    "type": "minecraft:notice",
    "title": "Feeding Module",
    "body": [
        {
            "type": "minecraft:item",
            "item": {
                "id": "minecraft:enchanted_book",
                "components": {
                    "minecraft:stored_enchantments": {
                        "enchantmentplus:feeding_module": 1
                    }
                }
            }
        },
        {
            "type": "minecraft:plain_message",
            "width": 600,
            "contents": [
                {
                    "text": "Type:",
                    "color": "gray"
                },
                {
                    "text": " Normal\n\n",
                    "color": "white"
                },
                {
                    "text": "Description:",
                    "color": "gray"
                },
                {
                    "text": " Automatically feeds the user with the food in the inventory.\n\n",
                    "color": "white"
                },
                {
                    "text": "Maximum Level:",
                    "color": "gray"
                },
                {
                    "text": " 1\n\n",
                    "color": "white"
                },
                {
                    "text": "Enchantment Cost Per Level:",
                    "color": "gray"
                },
                {
                    "text": " 1",
                    "color": "white"
                },
                {
                    "text": "   (!)\n\n",
                    "color": "yellow",
                    "hover_event": {
                        "action": "show_text",
                        "value": "Cost is halved if applied from an enchanted book"
                    }
                },
                {
                    "text": "Can be applied to:",
                    "color": "gray"
                },
                {
                    "text": " Helmet\n\n",
                    "color": "white"
                },
                {
                    "text": "Can be obtained from:",
                    "color": "gray"
                },
                {
                    "text": " Loot Chests, Fishing, Librarian Villager Trades\n\n",
                    "color": "white"
                },
                {
                    "text": "Incompatible with:",
                    "color": "red"
                },
                {
                    "text": " -\n\n",
                    "color": "white"
                },
                {
                    "text": "Details:",
                    "color": "gray"
                },
                {
                    "text": " Feeds the user with proper food every second. Only works with vanilla food. Highest value food will be eaten first. May waste half hunger bar of food at max. The enchantment also feeds the user when they take damage from an entity with ",
                    "color": "white"
                },
                {
                    "text": "<these>",
                    "color": "yellow",
                    "hover_event": {
                        "action": "show_text",
                        "value": "This will only feed the user if their both health and hunger are not full. In this case, hunger value of the food will be ignored. This is made so that the user is always kept regenerating while in combat."
                    }
                },
                {
                    "text": " conditions. Synergizes greatly with enchantments that exhaust the player.",
                    "color": "white"
                }
            ]
        }
    ],
    "action": {
        "label": "Back",
        "action": {
            "type": "show_dialog",
            "dialog": "enchantmentplus:new_enchantments"
        }
    }
}
