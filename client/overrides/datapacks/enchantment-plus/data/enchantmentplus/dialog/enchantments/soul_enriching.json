{
    "type": "minecraft:notice",
    "title": {
        "text": "Soul Enriching",
        "color": "dark_purple"
    },
    "body": [
        {
            "type": "minecraft:item",
            "item": {
                "id": "minecraft:enchanted_book",
                "components": {
                    "minecraft:stored_enchantments": {
                        "enchantmentplus:soul_enriching": 1
                    }
                }
            }
        },
        {
            "type": "minecraft:plain_message",
            "width": 600,
            "contents": [
                {
                    "text": "Type:",
                    "color": "gray"
                },
                {
                    "text": " Sacrificial\n\n",
                    "color": "dark_purple"
                },
                {
                    "text": "Description:",
                    "color": "gray"
                },
                {
                    "text": " Mining ores drains life from the user to grant a soul stack. At 5 stacks, souls enrich the next mined ore, tripling the yield.\n\n",
                    "color": "white"
                },
                {
                    "text": "Maximum Level:",
                    "color": "gray"
                },
                {
                    "text": " 1\n\n",
                    "color": "white"
                },
                {
                    "text": "Enchantment Cost Per Level:",
                    "color": "gray"
                },
                {
                    "text": " 2",
                    "color": "white"
                },
                {
                    "text": "   (!)\n\n",
                    "color": "yellow",
                    "hover_event": {
                        "action": "show_text",
                        "value": "Cost is halved if applied from an enchanted book"
                    }
                },
                {
                    "text": "Can be applied to:",
                    "color": "gray"
                },
                {
                    "text": " Pickaxe\n\n",
                    "color": "white"
                },
                {
                    "text": "Can be obtained from:",
                    "color": "gray"
                },
                {
                    "text": " Loot Chests, Fishing, Librarian Villager Trades\n\n",
                    "color": "white"
                },
                {
                    "text": "Incompatible with:",
                    "color": "red"
                },
                {
                    "text": " Earthly Gatherer, Extended, Lumberjack, Ore Excavation, Silk Touch\n\n",
                    "color": "white"
                },
                {
                    "text": "Details:",
                    "color": "gray"
                },
                {
                    "text": " Drained life is 0.5 heart. Compatible with Amethyst Cluster and all vanilla ores except Ancient Debris. Stacks with Fortune enchantment.",
                    "color": "white"
                }
            ]
        }
    ],
    "action": {
        "label": "Back",
        "action": {
            "type": "show_dialog",
            "dialog": "enchantmentplus:new_enchantments"
        }
    }
}
